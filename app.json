{
  "expo": {
    "name": "Loksewa Solution",
    "slug": "LoksewasolutionApp",
    "owner": "mrchettry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loksewasolutionapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loksewasolutionnp.hub",
      "icon": "./assets/images/logo-ios-1024.png",
      "associatedDomains": [
        "applinks:kbr.com.np",
        "applinks:loksewa-solution-app.firebaseapp.com"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "borderColor": "#000000",
      "barStyle": "light",
      "position": "relative",
      "enforceContrast": false
    },
    "android": {
      "package": "com.loksewasolutionnp.hub",
      "icon": "./assets/images/logo-android-512.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "kbr.com.np",
              "pathPrefix": "/constitution"
            },
            {
              "scheme": "https",
              "host": "loksewa-solution-app.firebaseapp.com",
              "pathPrefix": "/__/auth"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000030",
        "foregroundImage": "./assets/images/logo-android-512-safe.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000030",
          "dark": {
            "backgroundColor": "#000030"
          }
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "borderColor": "#000000",
          "barStyle": "light",
          "position": "relative"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Loksewa Solution to access your photos to set a profile picture or attach images to posts.",
          "cameraPermission": "Allow Loksewa Solution to access your camera to take a profile picture or attach photos to posts."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#DE6E00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#000000",
        "borderColor": "#000000",
        "barStyle": "light",
        "position": "relative"
      },
      "eas": {
        "projectId": "cd2fb7bb-37c0-4411-810a-a91177555f42"
      }
    }
  }
}
