rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Public read-only configuration used before login. No client can write it.
    match /app_onboarding-settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile. Privilege and subscription fields are never client-writable.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'role', 'isAdmin', 'isPremium', 'premiumPlanName',
          'premiumBillingCycle', 'premiumExpiryDate'
        ]);
      allow update: if isAdmin() ||
        (isOwner(userId) && changedOnly([
          'firstName', 'lastName', 'name', 'dob', 'gender', 'photoURL',
          'courseId', 'subcourseId', 'courseSetupComplete', 'stats', 'updatedAt',
          'unlockedAchievements'
        ]));
      allow delete: if isOwner(userId) || isAdmin();

      // Legacy mock/live-exam attempts and the newer Exam Hub attempts.
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
      match /exam_attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) && changedOnly(['read']) &&
          request.resource.data.read == true;
        allow create, delete: if isAdmin();
      }
      match /qotd/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Curriculum and content. Users can consume content; only admins can edit it.
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
        match /topics/{topicId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }
    match /questions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /mockTests/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /liveExams/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /currentAffairs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /gorkhapatra/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /achievements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leaderboard/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Discussion board: users may create their own posts/comments and adjust
    // counters through the narrow operations used by the app.
    match /discussions/{discussionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0;
      allow update: if isAdmin() ||
        (isSignedIn() && (
          (changedOnly(['likeCount']) &&
            (request.resource.data.likeCount == resource.data.likeCount + 1 ||
             request.resource.data.likeCount == resource.data.likeCount - 1)) ||
          (changedOnly(['commentCount']) &&
            (request.resource.data.commentCount == resource.data.commentCount + 1 ||
             request.resource.data.commentCount == resource.data.commentCount - 1))
        ));
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin() ||
          (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Legacy flat collections retained for data already created by the app.
    match /app_subcourses/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /subcourses/{subcourseId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
    match /app_categories/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_mocktest/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_syllabus/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_quiz_results/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /app_bookmarks/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /app_notes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_home_banners/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_developers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Exam Hub catalog. Reads remain public to preserve the existing website/app
    // behavior; all catalog mutations require an admin.
    match /app_exam_provinces/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_sections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_sets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_rankings/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.score is number &&
        request.resource.data.timeTakenSeconds is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.timeTakenSeconds >= 0;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Theory answer upload and admin review.
    match /app_exam_answers/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.score == 0 &&
        request.resource.data.passed == false &&
        request.resource.data.reviewedAt == null;
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.uid == request.auth.uid &&
         resource.data.status == 'pending' &&
         changedOnly(['pdfUrl', 'message']));
      allow delete: if isAdmin();
    }

    // Subscription catalog and payment configuration.
    match /app_subscription_plans/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_subscription_settings/{docId} {
      // Public settings contain only display-safe fields: gateway enabled flags,
      // optional public merchant identifiers, and manual QR payment details.
      // Secret keys must live in `private` or an external secret manager.
      allow read: if isSignedIn() && docId == 'public';
      allow read: if isAdmin() && docId == 'private';
      // Admins can inspect the legacy document while migrating it, but normal
      // users can never read `config` because it may contain secretKey fields.
      allow read: if isAdmin() && docId == 'config';
      allow create, update: if isAdmin() && (docId == 'public' || docId == 'private');
      allow delete: if isAdmin() && (docId == 'public' || docId == 'private');
    }
    match /app_coupon_codes/{code} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
         changedOnly(['usedCount']) &&
         request.resource.data.usedCount == resource.data.usedCount + 1);
    }
    match /app_subscriptions/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.adminMessage == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null;
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == resource.data.uid &&
         changedOnly(['transactionRef', 'screenshotUrl', 'customerMessage', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Default deny-all: any collection not explicitly listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
