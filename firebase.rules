rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Onboarding — read only (admin can write)
    match /app_onboarding-settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses & Subcourses — readable by anyone signed in, writable by admin only.
    // Subcourses live as a SUB-COLLECTION under each course document. A rule on the
    // parent path does NOT cascade to subcollections in Firestore — this explicit
    // nested match is required, otherwise subcourse reads/writes get "insufficient
    // permission" even though the parent course path is open.
    match /app_courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /subcourses/{subcourseId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
    // Legacy flat collection (kept read-only for backward compatibility with data
    // seeded before the sub-collection restructure).
    match /app_subcourses/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /meta/{docId} { allow read: if true; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    match /app_categories/{docId} { allow read: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /app_mocktest/{docId} { allow read: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /app_syllabus/{docId} { allow read: if isSignedIn(); allow create, update, delete: if isAdmin(); }

    match /app_quiz_results/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /app_bookmarks/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /app_notes/{docId} { allow read: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /app_notifications/{docId} { allow read: if isSignedIn(); allow create, update, delete: if isAdmin(); }

    // Home banners & About Developer — TEMPORARY: write:true so seeding works
    // before any admin account exists. TODO: once an admin user is set up,
    // change `allow write: if true` to `allow write: if isAdmin();` below
    // (same pattern as app_courses above) to lock this down.
    match /app_home_banners/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /app_developers/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny-all
    match /{document=**} { allow read, write: if false; }
  }
}
