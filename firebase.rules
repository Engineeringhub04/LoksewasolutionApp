rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Public read-only configuration used before login. No client can write it.
    match /app_onboarding-settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile. Privilege and subscription fields are never client-writable.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'role', 'isAdmin', 'isPremium', 'premiumPlanName',
          'premiumBillingCycle', 'premiumExpiryDate'
        ]);
      allow update: if isAdmin() ||
        (isOwner(userId) && changedOnly([
          'firstName', 'lastName', 'name', 'dob', 'gender', 'photoURL',
          'courseId', 'subcourseId', 'courseSetupComplete', 'stats', 'updatedAt',
          'unlockedAchievements'
        ]));
      allow delete: if isOwner(userId) || isAdmin();

      // Legacy mock/live-exam attempts and the newer Exam Hub attempts.
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
      match /exam_attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /learning_progress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) && changedOnly(['read']) &&
          request.resource.data.read == true;
        allow create, delete: if isAdmin();
      }
      match /qotd/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Phase 1 Subject catalog. Subject metadata is readable by signed-in users,
    // while every create/update/delete is restricted to administrators.
    match /app_subjects_details/{subjectId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name', 'course', 'subcourse', 'pro', 'price', 'order'
        ]);
      allow delete: if isAdmin();
    }

    // Phase 2 Subject structure catalog. All records are readable by signed-in
    // users, while only admins can seed or maintain validated catalog metadata.
    match /app_subjects_chapter_details/{documentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name', 'nameNe', 'order', 'course', 'subcourse', 'subjectId',
          'unit', 'unitId', 'pro', 'price', 'isPublished', 'isSeed',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.course is string &&
        request.resource.data.subcourse is string &&
        request.resource.data.subjectId is string &&
        request.resource.data.unit == null &&
        request.resource.data.unitId == null;
      allow delete: if isAdmin();
    }

    match /app_subjects_units_details/{documentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name', 'nameNe', 'order', 'course', 'subcourse', 'subjectId',
          'pro', 'price', 'chapterCount', 'isPublished', 'isSeed',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.course is string &&
        request.resource.data.subcourse is string &&
        request.resource.data.subjectId == 'technical-subject';
      allow delete: if isAdmin();
    }

    match /app_subjects_unit-chapters_details/{documentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name', 'nameNe', 'order', 'course', 'subcourse', 'subjectId',
          'unitId', 'unit', 'unitNameNe', 'pro', 'price', 'isPublished',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.course is string &&
        request.resource.data.subcourse is string &&
        request.resource.data.subjectId == 'technical-subject' &&
        request.resource.data.unitId is string;
      allow delete: if isAdmin();
    }

    // Phase 5 learning questions. Published questions are readable by signed-in
    // learners; seed and moderation writes are restricted to administrators.
    match /app_subject_cucqdata_Allmode/{questionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.isPublished == true);
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'id', 'sourceId', 'courseId', 'subcourseId', 'subjectId', 'unitId',
          'chapterId', 'mode', 'order', 'difficulty', 'text', 'textNe',
          'options', 'optionsNe', 'correctIndex', 'explanation', 'explanationNe',
          'isPublished', 'isPremium', 'price', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.courseId is string &&
        request.resource.data.subcourseId is string &&
        request.resource.data.subjectId is string &&
        request.resource.data.chapterId is string &&
        request.resource.data.mode in ['practice', 'read'] &&
        request.resource.data.difficulty in ['easy', 'medium', 'hard'];
      allow delete: if isAdmin();
    }

    // Phase 5 theory resources. The PDF remains external/storage-backed; this
    // collection stores only chapter metadata and the resource URL.
    match /app_subject_theory_resources/{resourceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.isPublished == true);
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'id', 'courseId', 'subcourseId', 'subjectId', 'unitId', 'chapterId',
          'title', 'titleNe', 'resourceType', 'notes', 'notesNe', 'pdfUrl',
          'notesUrl', 'isConfigured', 'isPublished', 'isPremium', 'price',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.courseId is string &&
        request.resource.data.subcourseId is string &&
        request.resource.data.subjectId is string &&
        request.resource.data.chapterId is string &&
        request.resource.data.resourceType == 'pdf';
      allow delete: if isAdmin();
    }

    // Legacy question data remains available to existing non-learning flows. The
    // Phase 1 Subject catalog deliberately has no access to the old subject tree.
    match /questions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /mockTests/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /liveExams/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /currentAffairs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /gorkhapatra/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /achievements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leaderboard/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Discussion board. User-owned fields remain editable only by the owner;
    // admin metadata and moderation fields remain admin-controlled.
    match /discussions/{discussionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.isSeed == false &&
        (request.resource.data.isAdmin == false || isAdmin());
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid &&
          changedOnly(['title', 'body', 'category', 'imageUrl', 'linkUrl', 'editedAt'])) ||
        (isSignedIn() && (
          (changedOnly(['likeCount']) &&
            (request.resource.data.likeCount == resource.data.likeCount + 1 ||
             request.resource.data.likeCount == resource.data.likeCount - 1)) ||
          (changedOnly(['commentCount']) &&
            (request.resource.data.commentCount == resource.data.commentCount + 1 ||
             request.resource.data.commentCount == resource.data.commentCount - 1))
        ));
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAdmin() ||
          (isSignedIn() && resource.data.authorId == request.auth.uid &&
            changedOnly(['body', 'editedAt'])) ||
          (isSignedIn() && changedOnly(['likeCount']) &&
            (request.resource.data.likeCount == resource.data.likeCount + 1 ||
             request.resource.data.likeCount == resource.data.likeCount - 1));
        allow delete: if isAdmin() ||
          (isSignedIn() && resource.data.authorId == request.auth.uid);
        match /reactions/{userId} {
          allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
          allow create: if isSignedIn() && request.auth.uid == userId;
          allow delete: if isSignedIn() && request.auth.uid == userId;
          allow update: if false;
        }

        match /replies/{replyId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
          allow update: if isAdmin() ||
            (isSignedIn() && resource.data.authorId == request.auth.uid &&
              changedOnly(['body', 'editedAt'])) ||
            (isSignedIn() && changedOnly(['likeCount']) &&
              (request.resource.data.likeCount == resource.data.likeCount + 1 ||
               request.resource.data.likeCount == resource.data.likeCount - 1));
          allow delete: if isAdmin() ||
            (isSignedIn() && resource.data.authorId == request.auth.uid);
          match /reactions/{userId} {
            allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
            allow create: if isSignedIn() && request.auth.uid == userId;
            allow delete: if isSignedIn() && request.auth.uid == userId;
            allow update: if false;
          }
        }
      }

      match /reactions/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    match /app_discussion_guidelines/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Private report history. Users can create/read only their own pending reports;
    // review status and admin messages are console/admin controlled.
    match /app_report_history/{reportId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.adminMessage == null;
      allow update, delete: if isAdmin();
    }

    // Legacy flat collections retained for data already created by the app.
    match /app_subcourses/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /subcourses/{subcourseId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
    match /app_categories/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_mocktest/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_syllabus/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_quiz_results/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /app_bookmarks/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /app_notes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_home_banners/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /app_developers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Exam Hub catalog. Reads remain public to preserve the existing website/app
    // behavior; all catalog mutations require an admin.
    match /app_exam_provinces/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_sections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_sets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_exam_rankings/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.score is number &&
        request.resource.data.timeTakenSeconds is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.timeTakenSeconds >= 0;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Theory answer upload and admin review.
    match /app_exam_answers/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.score == 0 &&
        request.resource.data.passed == false &&
        request.resource.data.reviewedAt == null;
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.uid == request.auth.uid &&
         resource.data.status == 'pending' &&
         changedOnly(['pdfUrl', 'message']));
      allow delete: if isAdmin();
    }

    // Subscription catalog and payment configuration.
    match /app_subscription_plans/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_subscription_settings/{docId} {
      // Keep the existing `config` document. It is readable only after secretKey
      // fields have been removed. Firestore cannot return only selected fields,
      // so a document containing a secret must never be client-readable.
      allow read: if isSignedIn() && docId == 'config' &&
        (!resource.data.keys().hasAny(['esewa']) ||
         !resource.data.esewa.keys().hasAny(['secretKey'])) &&
        (!resource.data.keys().hasAny(['khalti']) ||
         !resource.data.khalti.keys().hasAny(['secretKey']));
      // Prevent future accidental reintroduction of provider secrets into the
      // client-readable config document. Store production secrets only in a
      // secure backend/secret manager.
      allow create, update: if isAdmin() && docId == 'config' &&
        (!request.resource.data.keys().hasAny(['esewa']) ||
         !request.resource.data.esewa.keys().hasAny(['secretKey'])) &&
        (!request.resource.data.keys().hasAny(['khalti']) ||
         !request.resource.data.khalti.keys().hasAny(['secretKey']));
      allow delete: if isAdmin() && docId == 'config';
    }
    match /app_coupon_codes/{code} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
         changedOnly(['usedCount']) &&
         request.resource.data.usedCount == resource.data.usedCount + 1);
    }
        match /app_subscriptions/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.adminMessage == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null;
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == resource.data.uid &&
         changedOnly(['transactionRef', 'screenshotUrl', 'customerMessage', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Individual premium exam purchase requests. Users can only create and edit
    // their own pending payment proof; status, amount and entitlement are admin-only.
    match /app_exam_purchases/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0 &&
        request.resource.data.adminMessage == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null;
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.uid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.amount == resource.data.amount &&
         changedOnly(['transactionRef', 'screenshotUrl', 'customerMessage', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Individual Subject/Unit/Chapter purchase requests. Users can create and
    // edit only their own pending payment proof; amount, entitlement and review
    // status remain admin-controlled.
    match /app_content_purchases/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0 &&
        request.resource.data.method == 'qr' &&
        request.resource.data.adminMessage == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null;
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.uid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.amount == resource.data.amount &&
         request.resource.data.contentId == resource.data.contentId &&
         request.resource.data.contentType == resource.data.contentType &&
         changedOnly(['transactionRef', 'screenshotUrl', 'customerMessage', 'updatedAt']));
      allow delete: if isAdmin();
    }
    // Default deny-all: any collection not explicitly listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
