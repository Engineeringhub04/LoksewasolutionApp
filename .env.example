# Firebase project config — copy this file to .env and fill in real values
# from Firebase Console → Project Settings → General → Your apps → Web app config.
# See README.md "Firebase Setup" for the exact steps.

EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_REAL_VALUE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_REAL_VALUE
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_PROJECT_ID.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_REAL_VALUE
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_REAL_VALUE

# Google Sign-In Web Client ID (used by Expo Go proxy and web)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_REAL_VALUE.apps.googleusercontent.com

# Native client IDs (used automatically by Development Builds and production apps)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com

# --- Messaging relays (Apps Script web apps) ---
# Theory-answer upload -> Discord relay /exec URL. See docs/apps-script-*.gs.
EXPO_PUBLIC_EXAM_ANSWER_WEBHOOK_URL=REPLACE_WITH_EXAM_ANSWER_WEBHOOK_URL
# Admin-alert relay /exec URL (a SEPARATE Apps Script project) and the secret
# that must match its SHARED_SECRET script property. See docs/apps-script-admin-alerts.gs.
EXPO_PUBLIC_ADMIN_ALERT_WEBHOOK_URL=REPLACE_WITH_ADMIN_ALERT_WEBHOOK_URL
EXPO_PUBLIC_ADMIN_ALERT_SHARED_SECRET=REPLACE_WITH_ADMIN_ALERT_SHARED_SECRET

# --- Cloudinary (unsigned uploads for profile photos / answer PDFs) ---
# cloudName + the UNSIGNED upload preset name from your Cloudinary dashboard.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=REPLACE_WITH_CLOUDINARY_UPLOAD_PRESET

